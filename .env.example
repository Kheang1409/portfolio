# KaiAssistant Portfolio - Production Environment Template
# Copy this file to .env and fill in all values from your secret store
# NEVER commit .env to version control!

# =============================================================================
# CORE CONFIGURATION
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
NODE_ENV=production

# =============================================================================
# DATABASE (MongoDB Atlas) - REQUIRED
# =============================================================================
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_CONNECTIONSTRING=
MONGODB_DATABASE=KaiAssistant

# =============================================================================
# REDIS (TLS REQUIRED IN PRODUCTION) - REQUIRED
# =============================================================================
# Use rediss:// for TLS (production). Format: rediss://<host>:<port>
REDIS__CONNECTIONSTRING=rediss://redis:6380
# Set to true to enforce distributed rate limiting (requires reliable Redis)
REDIS__STRICTDISTRIBUTEDMODE=true

# =============================================================================
# AI ASSISTANT (Google Gemini) - REQUIRED
# =============================================================================
GEMINI_API_KEY=
# Comma-separated model names (primary, fallback)
GEMINI_MODEL_NAMES=gemini-3.1-flash-lite-preview:generateContent,gemini-3-flash-preview:generateContent,gemini-2.5-flash:generateContent,gemini-2.5-flash-lite:generateContent
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/
GEMINI_SYSTEM_PROMPT=You are a professional portfolio assistant. Help visitors learn about the profile, skills, and experience provided in retrieved portfolio data.
GEMINI_PROMPT_MAX_CHARS=10000
GEMINI_INCLUDE_PERSONAL_DETAILS=true
GEMINI_TEMPERATURE=0.7
GEMINI_TOPK=40
GEMINI_TOPP=0.95
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_CANDIDATE_COUNT=1

# =============================================================================
# PAYPAL DONATIONS - REQUIRED
# =============================================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be 'live' for production
PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_EMAIL_RETENTION_DAYS=30

# =============================================================================
# SMTP / EMAIL (Gmail App Password or transactional email service) - REQUIRED
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
SMTP_RECEIVER_EMAIL=
SMTP_ENABLED=true

# =============================================================================
# CORS & SECURITY - REQUIRED
# =============================================================================
# Comma-separated production domains (no trailing slashes)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Internal Docker network URL for backend
BACKEND_API_URL=http://backend:8080
GITHUB_USER=
GITHUB_TOKEN=
GITHUB_USER_AGENT=kai-portfolio-site

# =============================================================================
# OBSERVABILITY (Optional)
# =============================================================================
# OpenTelemetry OTLP endpoint (e.g., https://otel-collector:4317 or Grafana Cloud endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kai-assistant-api

# =============================================================================
# REDIS TLS CERTIFICATES (Mounted via redis-certs volume)
# =============================================================================
# These are paths inside the Redis container (do not change)
# REDIS_TLS_CERT_FILE=/etc/redis/tls/redis.crt
# REDIS_TLS_KEY_FILE=/etc/redis/tls/redis.key
# REDIS_TLS_CA_CERT_FILE=/etc/redis/tls/ca.crt